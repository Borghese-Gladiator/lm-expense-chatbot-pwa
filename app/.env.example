# Postgres connection. On Vercel, the Neon integration sets this.
# Leave empty to use a local PGlite database in .data/pglite.
DATABASE_URL=

# Required on Vercel. The browser asks for it (any user name).
APP_PASSWORD=
# Vercel sends this to /api/cron/sync. Set any long random value.
CRON_SECRET=

# 16+ characters. Encrypts the Plaid access tokens. Do not change it after you connect a bank.
APP_SECRET_KEY=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional. Turns on Ask.
ANTHROPIC_API_KEY=
MODEL=claude-opus-5-5
CURRENCY=USD
